{
  "paths": {
    "input_data": "../data/BN278_OASIS3_hc/timeseries.npy",
    "symbolic_output_root": "../outputs/symbolic_search",
    "hmm_output_root": "../outputs/hmm_results",
    "score_output_root": "../outputs/score_results",
    "figure_output_root": "../outputs/figures",
    "metadata_csv": "../data/BN278_OASIS3_hc/metadata.csv",
    "dataset_npz": "../data/BN278_OASIS3_hc/dataset.npz"
  },
  "preprocess": {
    "standardize_method": "zscore",
    "smooth": true,
    "smooth_window": 3,
    "center_diff_on_diff_series": true,
    "fill_first_diff": "zero"
  },
  "symbolic": {
    "deviation_thresholds": [0.7, 0.9, 1.1, 1.3],
    "momentum_thresholds": [ 0.7, 0.9, 1.1, 1.3]
  },
  "hmm": {
    "n_hidden_states_values": [5, 6, 7,8,9],
    "n_iter": 200,
    "tol": 0.0001,
    "random_state": 188,
    "verbose": false
  },
  "score": {
    "weights": {
        "state_usage_entropy": 1.0,
        "observation_entropy": 1.0,
        "used_observation_fraction": 1.0,
        "effective_state_fraction": 1.5,
        "non_fragmented_state_fraction": 2.0
    },

    "normalize_scores_across_runs": true,

    "quality_weight": 0.9,
    "age_weight": 0.1,
    "age_top_k": 3,

    "min_state_fo": 0.01,
    "short_mdt_threshold": 1.1
  },
  "visualization": {
    "dpi": 300,
    "fig_format": "png",
    "top_n_score_runs": 10,
    "show_titles": true,
    "save_symbolic_distribution": true,
    "save_transition_matrix": true,
    "save_fo_bar": true,
    "save_mdt_bar": true,
    "save_score_bar": true
  }
}